/* =========================================
   FITLIFE PRO - COMPLETE WEBSITE DESIGN
   ========================================= */

/* ---------- BASIC RESET ---------- */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    background: #f5f8f6;
    color: #1f2933;
    line-height: 1.6;
}

a {
    text-decoration: none;
    color: inherit;
}


/* ---------- NAVBAR ---------- */

.nav {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px 7%;
    background: white;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
    position: sticky;
    top: 0;
    z-index: 1000;
}

.logo {
    font-size: 25px;
    font-weight: bold;
    color: #1b5e20;
}

.logo span {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    margin-right: 6px;
    border-radius: 50%;
    background: #2e7d32;
    color: white;
}

.logo b {
    color: #66bb6a;
}

.nav a {
    margin-left: 20px;
    color: #374151;
    font-weight: 600;
    transition: 0.3s;
}

.nav a:hover {
    color: #2e7d32;
}


/* ---------- HERO SECTION ---------- */

.hero {
    min-height: 600px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 50px;
    padding: 80px 8%;
    background: linear-gradient(135deg, #e8f5e9, #f7fff8);
}

.hero > div:first-child {
    max-width: 650px;
}

.eyebrow {
    display: inline-block;
    margin-bottom: 15px;
    color: #2e7d32;
    font-size: 14px;
    font-weight: bold;
    letter-spacing: 2px;
}

.hero h1 {
    font-size: clamp(42px, 6vw, 72px);
    line-height: 1.05;
    color: #16351a;
    margin-bottom: 25px;
}

.hero h1 em {
    color: #2e7d32;
    font-style: normal;
}

.hero p {
    max-width: 600px;
    color: #52605a;
    font-size: 18px;
    margin-bottom: 25px;
}

.actions {
    margin: 25px 0;
}


/* ---------- BUTTONS ---------- */

.btn {
    display: inline-block;
    padding: 13px 25px;
    border-radius: 30px;
    font-weight: bold;
    margin-right: 10px;
    transition: 0.3s;
}

.btn:hover {
    transform: translateY(-3px);
}

.btn.primary {
    background: #2e7d32;
    color: white;
    box-shadow: 0 8px 20px rgba(46, 125, 50, 0.25);
}

.btn.primary:hover {
    background: #1b5e20;
}

.btn.ghost {
    border: 2px solid #2e7d32;
    color: #2e7d32;
    background: white;
}

.btn.ghost:hover {
    background: #2e7d32;
    color: white;
}

.btn.light {
    background: white;
    color: #1b5e20;
}


/* ---------- TRUST ITEMS ---------- */

.trust {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    margin-top: 25px;
}

.trust span {
    color: #4b6351;
    font-size: 14px;
    font-weight: 600;
}


/* ---------- HERO ART ---------- */

.hero-art {
    width: 400px;
    height: 400px;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
}

.orb {
    width: 300px;
    height: 300px;
    border-radius: 50%;
    background: linear-gradient(135deg, #66bb6a, #1b5e20);
    box-shadow: 0 25px 60px rgba(46, 125, 50, 0.25);
}

.hero-word {
    position: absolute;
    text-align: center;
    color: white;
    font-size: 42px;
    font-weight: bold;
    letter-spacing: 3px;
}

.hero-word span {
    font-size: 28px;
    letter-spacing: 8px;
}


/* ---------- FLOATING CARDS ---------- */

.float {
    position: absolute;
    background: white;
    padding: 15px 20px;
    border-radius: 15px;
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.15);
}

.float b {
    display: block;
    color: #1b5e20;
}

.float small {
    color: #777;
}

.float.one {
    top: 30px;
    right: 0;
}

.float.two {
    bottom: 30px;
    left: 0;
}


/* ---------- SECTION ---------- */

.section {
    padding: 80px 8%;
    background: white;
}

.section-head {
    margin-bottom: 40px;
}

.section h2 {
    font-size: 42px;
    color: #173b1d;
    margin-bottom: 15px;
}


/* ---------- CARD GRID ---------- */

.grid4 {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 25px;
}

.tile {
    padding: 30px;
    min-height: 230px;
    border-radius: 20px;
    background: #f7faf7;
    border: 1px solid #e0ebe2;
    transition: 0.3s;
}

.tile:hover {
    transform: translateY(-8px);
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.1);
}

.tile i {
    display: block;
    font-size: 40px;
    margin-bottom: 20px;
}

.tile h3 {
    font-size: 22px;
    color: #245b2b;
    margin-bottom: 10px;
}

.tile p {
    color: #65736a;
}


/* ---------- DARK SECTION ---------- */

.section.dark {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 50px;
    background: #173b1d;
    color: white;
}

.section.dark h2 {
    color: white;
}

.section.dark p {
    color: #d4e4d6;
    max-width: 600px;
    margin-bottom: 25px;
}

.eyebrow.lime {
    color: #9be7a0;
}


/* ---------- QUOTE / STEPS ---------- */

.quote {
    min-width: 280px;
    padding: 30px;
    border-radius: 20px;
    background: rgba(255, 255, 255, 0.08);
}

.quote strong {
    color: #9be7a0;
    font-size: 28px;
}

.quote p {
    margin: 5px 0 20px;
}


/* ---------- FOOTER ---------- */

footer {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 40px;
    padding: 60px 8%;
    background: #0d2111;
    color: white;
}

footer .logo {
    color: white;
}

footer p {
    color: #b9c8bc;
    margin-top: 15px;
    max-width: 350px;
}

footer b {
    display: block;
    margin-bottom: 15px;
    color: #9be7a0;
}

footer a {
    display: block;
    margin: 8px 0;
    color: #d8e3da;
}

footer a:hover {
    color: #9be7a0;
}


/* ---------- RESPONSIVE DESIGN ---------- */

@media (max-width: 1000px) {

    .grid4 {
        grid-template-columns: repeat(2, 1fr);
    }

    .hero {
        flex-direction: column;
        text-align: center;
    }

    .hero p {
        margin-left: auto;
        margin-right: auto;
    }

    .trust {
        justify-content: center;
    }

    .hero-art {
        margin-top: 30px;
    }

    .section.dark {
        flex-direction: column;
        align-items: flex-start;
    }
}


@media (max-width: 700px) {

    .nav {
        padding: 15px 5%;
    }

    .nav a {
        margin-left: 8px;
        font-size: 13px;
    }

    .hero {
        padding: 60px 5%;
    }

    .hero h1 {
        font-size: 42px;
    }

    .hero-art {
        width: 300px;
        height: 300px;
    }

    .orb {
        width: 220px;
        height: 220px;
    }

    .hero-word {
        font-size: 30px;
    }

    .float {
        padding: 10px;
        font-size: 12px;
    }

    .section {
        padding: 60px 5%;
    }

    .section h2 {
        font-size: 32px;
    }

    .grid4 {
        grid-template-columns: 1fr;
    }

    footer {
        grid-template-columns: 1fr;
        padding: 50px 5%;
    }
}
