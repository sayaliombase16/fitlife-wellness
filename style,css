body {
    margin: 0;
    font-family: Arial, sans-serif;
    background: #f5f7f6;
    color: #222;
}

.nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 50px;
    background: #ffffff;
}

.logo {
    font-size: 24px;
    font-weight: bold;
}

.hero {
    padding: 80px 50px;
    text-align: center;
    background: #e8f5e9;
}

.hero h1 {
    font-size: 48px;
    margin: 20px 0;
}

.hero p {
    font-size: 18px;
}

.btn {
    display: inline-block;
    padding: 12px 25px;
    margin: 10px;
    text-decoration: none;
    border-radius: 8px;
}

.primary {
    background: #2e7d32;
    color: white;
}

.ghost {
    border: 2px solid #2e7d32;
    color: #2e7d32;
}
